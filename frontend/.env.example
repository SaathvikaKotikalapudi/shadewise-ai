# ShadeWise AI - Frontend Environment Configuration Template
# Duplicate this file as .env or .env.local for local customization.

# Backend Express API URL (Phase 2 backend server)
VITE_API_BASE_URL=http://localhost:5000/api

# Feature Flags
VITE_ENABLE_LIVE_WEATHER=false
VITE_ENABLE_LIVE_ROUTING=false
VITE_ENABLE_GEMINI_AI=false

# Note: Live API keys (Open-Meteo, Gemini AI, etc.) are kept securely
# in the backend server (.env) and are never exposed in the client bundle.
